{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://helm.sh/docs/loaders/helm-schema-json",
  "title": "Docling Serve",
  "description": "A Helm chart for deploying Docling Serve - document conversion API service",
  "type": "object",
  "required": ["image", "service", "config"],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 0,
      "default": 1
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["IfNotPresent", "Always", "Never"]
        },
        "pullSecrets": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["repository", "tag"]
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "service": {
          "type": "object",
          "properties": {
            "type": { "type": "string" },
            "port": { "type": "integer" },
            "annotations": { "type": "object" }
          }
        }
      }
    },
    "containerPorts": {
      "type": "object",
      "properties": {
        "http": { "type": "integer" },
        "metrics": { "type": "integer" }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "host": { "type": "string" },
        "path": { "type": "string" },
        "pathType": { "type": "string" },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "secretName": { "type": "string" }
          }
        },
        "annotations": { "type": "object" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "resources": {
      "type": "object",
      "properties": {
        "limits": {
          "type": "object",
          "properties": {
            "cpu": { "type": "string" },
            "memory": { "type": "string" }
          }
        },
        "requests": {
          "type": "object",
          "properties": {
            "cpu": { "type": "string" },
            "memory": { "type": "string" }
          }
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer" },
        "maxReplicas": { "type": "integer" },
        "targetCPUUtilizationPercentage": { "type": "integer" },
        "targetMemoryUtilizationPercentage": { "type": "string" }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "enable_ui": { "type": "boolean" },
        "api_host": { "type": "string" },
        "log_level": { "type": "string" },
        "log_format": { "type": "string" },
        "static_path": { "type": "string" },
        "artifacts_path": { "type": "string" },
        "scratch_path": { "type": "string" },
        "single_use_results": { "type": "boolean" },
        "load_models_at_boot": { "type": "boolean" },
        "options_cache_size": { "type": "integer" },
        "enable_remote_services": { "type": "boolean" },
        "allow_external_plugins": { "type": "boolean" },
        "allow_custom_vlm_config": { "type": "boolean" },
        "allow_custom_picture_description_config": { "type": "boolean" },
        "allow_custom_code_formula_config": { "type": "boolean" },
        "allow_custom_table_structure_config": { "type": "boolean" },
        "allow_custom_layout_config": { "type": "boolean" },
        "allow_custom_picture_classification_config": { "type": "boolean" },
        "allow_custom_ocr_config": { "type": "boolean" },
        "show_version_info": { "type": "boolean" },
        "enable_management_endpoints": { "type": "boolean" },
        "debug_error_details": { "type": "boolean" },
        "max_document_timeout": { "type": "integer" },
        "max_num_pages": { "type": "integer" },
        "max_file_size": { "type": "integer" },
        "max_sources_per_request": { "type": "integer" },
        "max_images_scale": { "type": "number" },
        "artifact_storage_enabled": { "type": "boolean" },
        "artifact_storage_endpoint": { "type": "string" },
        "artifact_storage_bucket": { "type": "string" },
        "artifact_storage_key_prefix": { "type": "string" },
        "artifact_storage_presign_ttl_seconds": { "type": "integer" },
        "queue_max_size": { "type": "string" },
        "ocr_batch_size": { "type": "string" },
        "layout_batch_size": { "type": "string" },
        "table_batch_size": { "type": "string" },
        "batch_polling_interval_seconds": { "type": "string" },
        "sync_poll_interval": { "type": "integer" },
        "max_sync_wait": { "type": "integer" },
        "cors_origins": { "type": "string" },
        "cors_methods": { "type": "string" },
        "cors_headers": { "type": "string" },
        "eng_kind": { "type": "string" },
        "eng_loc_num_workers": { "type": "integer" },
        "eng_loc_share_models": { "type": "boolean" },
        "otel_enable_metrics": { "type": "boolean" },
        "otel_enable_traces": { "type": "boolean" },
        "otel_enable_prometheus": { "type": "boolean" },
        "otel_service_name": { "type": "string" },
        "metrics_port": { "type": "integer" },
        "default_vlm_preset": { "type": "string" },
        "default_picture_description_preset": { "type": "string" },
        "default_code_formula_preset": { "type": "string" },
        "default_picture_classification_preset": { "type": "string" },
        "default_table_structure_kind": { "type": "string" },
        "default_table_structure_preset": { "type": "string" },
        "default_layout_kind": { "type": "string" },
        "default_layout_preset": { "type": "string" },
        "default_ocr_preset": { "type": "string" },
        "default_ocr_kind": { "type": "string" }
      }
    },
    "externalModel": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "baseUrl": { "type": "string" },
        "apiKey": { "type": "string" },
        "timeout": { "type": "number" },
        "defaultModel": { "type": "string" }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "existingSecret": { "type": "string" },
        "apiKey": { "type": "string" },
        "externalModelApiKey": { "type": "string" }
      }
    },
    "extraEnv": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "extraEnvFrom": {
      "type": "array"
    },
    "extraVolumeMounts": {
      "type": "array"
    },
    "extraVolumes": {
      "type": "array"
    },
    "initContainers": {
      "type": "array"
    },
    "sidecars": {
      "type": "array"
    },
    "strategy": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "rollingUpdate": {
          "type": "object",
          "properties": {
            "maxSurge": {},
            "maxUnavailable": {}
          }
        }
      }
    },
    "livenessProbe": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "path": { "type": "string" },
        "initialDelaySeconds": { "type": "integer" },
        "periodSeconds": { "type": "integer" },
        "timeoutSeconds": { "type": "integer" },
        "failureThreshold": { "type": "integer" }
      }
    },
    "readinessProbe": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "path": { "type": "string" },
        "initialDelaySeconds": { "type": "integer" },
        "periodSeconds": { "type": "integer" },
        "timeoutSeconds": { "type": "integer" },
        "failureThreshold": { "type": "integer" }
      }
    },
    "startupProbe": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "path": { "type": "string" },
        "initialDelaySeconds": { "type": "integer" },
        "periodSeconds": { "type": "integer" },
        "failureThreshold": { "type": "integer" }
      }
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "topologySpreadConstraints": {
      "type": "array"
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": {},
        "maxUnavailable": {}
      }
    }
  }
}