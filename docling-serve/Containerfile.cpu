# CPU-only Dockerfile for docling-serve with external VLM APIs
# No local models - all processing via external APIs
#
# External APIs:
# - MiniMax M2.7 for OCR/Layout/Table (text API)
# - DeepSeek-OCR-2 for Picture Description (vision API)

ARG BASE_IMAGE=quay.io/sclorg/python-312-c9s:c9s

ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.8.19

ARG MIMALLOC_VERSION=v3.2.8

###################################################################################################
# Build mimalloc (optional, for performance)                                                    #
###################################################################################################

FROM ${BASE_IMAGE} AS mimalloc

ARG MIMALLOC_VERSION

USER 0

RUN dnf install -y --best --nodocs --setopt=install_weak_deps=False gcc gcc-c++ make cmake git

RUN git clone --depth 1 --branch ${MIMALLOC_VERSION} https://github.com/microsoft/mimalloc.git /opt/app-root/src/mimalloc

WORKDIR /opt/app-root/src/mimalloc/out/release
RUN cmake ../.. && make


FROM ${BASE_IMAGE} AS docling-base

###################################################################################################
# OS Layer (minimal - no GPU dependencies)                                                        #
###################################################################################################

USER 0

RUN --mount=type=bind,source=os-packages.txt,target=/tmp/os-packages.txt \
    dnf -y install --best --nodocs --setopt=install_weak_deps=False dnf-plugins-core && \
    dnf config-manager --best --nodocs --setopt=install_weak_deps=False --save && \
    dnf config-manager --enable crb && \
    dnf -y update && \
    dnf install -y $(cat /tmp/os-packages.txt) && \
    dnf -y clean all && \
    rm -rf /var/cache/dnf

COPY --from=mimalloc /opt/app-root/src/mimalloc/out/release/libmimalloc.so /usr/local/lib/libmimalloc.so
RUN /usr/bin/fix-permissions /opt/app-root/src/.cache


FROM ${UV_IMAGE} AS uv_stage

###################################################################################################
# Docling layer (CPU-only, no local models)                                                        #
###################################################################################################

FROM docling-base

USER 1001

WORKDIR /opt/app-root/src

ENV \
    OMP_NUM_THREADS=4 \
    LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8 \
    PYTHONIOENCODING=utf-8 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/app-root \
    DOCLING_SERVE_ARTIFACTS_PATH=/opt/app-root/src/.cache/docling/models

# NO local models needed - using external APIs only
ENV DOCLING_SERVE_LOAD_MODELS_AT_BOOT=false

# Sync dependencies WITHOUT GPU extras (no flash-attn, no --all-extras)
# Using CPU-only torch index to avoid GPU dependencies
# Note: pyproject.toml default-groups=["dev", "pypi"] uses GPU torch
# We override via UV_EXTRA_SYNC_ARGS to use cpu group
RUN --mount=from=uv_stage,source=/uv,target=/bin/uv \
    --mount=type=cache,target=/opt/app-root/src/.cache/uv,uid=1001 \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    umask 002 && \
    UV_SYNC_ARGS="--frozen --no-dev" && \
    uv sync ${UV_SYNC_ARGS} --group=dev --group=cpu --no-group=pypi

# Copy docling_serve source
COPY --chown=1001:0 ./docling_serve ./docling_serve

# Re-sync to ensure all dependencies are installed
RUN --mount=from=uv_stage,source=/uv,target=/bin/uv \
    --mount=type=cache,target=/opt/app-root/src/.cache/uv,uid=1001 \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    umask 002 && \
    uv sync --frozen --no-dev

ENV LD_PRELOAD=/usr/local/lib/libmimalloc.so
EXPOSE 5001

CMD ["docling-serve", "run"]