# Docling Serve - Docker Environment Configuration
# Copy to .env and customize as needed

# ===========================================
# Server Settings
# ===========================================
DOCLING_SERVE_HOST=0.0.0.0
DOCLING_SERVE_PORT=5001
DOCLING_SERVE_ENABLE_UI=true

# ===========================================
# External Model API (Ollama/vLLM)
# ===========================================
# Set to true to enable external model API
EXTERNAL_MODEL_ENABLED=false

# Base URL for OpenAI-compatible API
# Examples:
#   - Ollama local: http://localhost:11434/v1
#   - Ollama Docker: http://ollama:11434/v1
#   - vLLM: http://vllm:8000/v1
EXTERNAL_MODEL_URL=http://localhost:11434/v1

# Default model name
EXTERNAL_MODEL_NAME=llama3.2-vision

# Request timeout in seconds
EXTERNAL_MODEL_TIMEOUT=60

# API key for external service (if required)
# EXTERNAL_MODEL_API_KEY=your-api-key

# ===========================================
# Async Engine
# ===========================================
# Options: local, rq, ray
DOCLING_SERVE_ENG_KIND=local

# Local engine workers
DOCLING_SERVE_ENG_LOC_NUM_WORKERS=2

# RQ engine (if using DOCLING_SERVE_ENG_KIND=rq)
# DOCLING_SERVE_ENG_RQ_REDIS_URL=redis://redis:6379/0

# Ray engine (if using DOCLING_SERVE_ENG_KIND=ray)
# DOCLING_SERVE_ENG_RAY_ADDRESS=auto
# DOCLING_SERVE_ENG_RAY_REDIS_URL=redis://redis:6379/0

# ===========================================
# Security
# ===========================================
# Set API key for authentication (optional)
# Leave empty to disable authentication
DOCLING_SERVE_API_KEY=

# ===========================================
# Resource Limits
# ===========================================
DOCLING_SERVE_MAX_DOCUMENT_TIMEOUT=604800
DOCLING_SERVE_MAX_NUM_PAGES=10000
DOCLING_SERVE_MAX_FILE_SIZE=536870912

# ===========================================
# Logging
# ===========================================
DOCLING_SERVE_LOG_LEVEL=INFO
DOCLING_SERVE_LOG_FORMAT=text